{
  "name": "dsh-dnd",
  "version": "0.4.1",
  "private": true,
  "description": "D&D for DSH: a native Host tool suite (dice, SRD lookup, campaign search, character state, XP and coin), a Client character panel, and the D&D Game Master agent preset — one unified bundle install.",
  "type": "module",
  "main": "lib/host/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/host/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "data",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:writes": "node scripts/write-tools-scenario.mjs",
    "test:concurrency": "node scripts/concurrency-scenario.mjs",
    "test:ownership": "node scripts/audit-test-ownership.mjs",
    "verify": "node scripts/verify-client.mjs",
    "check": "npm run build && npm test && npm run test:ownership && npm run verify && node scripts/audit-paths.mjs && npm run test:writes && npm run test:concurrency",
    "prepare": "husky"
  },
  "license": "MIT",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  }
}
