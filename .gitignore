node_modules/
*.log
.DS_Store

# Scratch files: temp commit messages and one-off diagnostics.
# COMMIT_* rather than COMMIT_MSG* — the per-step messages are named
# COMMIT_2A.txt and slipped through the narrower pattern.
COMMIT_*.txt
_diag.mjs

# Check-run output dumps and one-off acceptance probes. These are the raw stdout
# of `npm run check` captured to a file for reading, plus single-use scripts
# written to inspect one behaviour. They are regenerable and were never meant to
# ship: a release commit published ~250 KB of them before these patterns existed.
check-*.txt
.check-*.txt
.acceptance-*.json
probe-*.mjs

# Real-browser verification screenshots, produced by scripts/browser-verify.mjs.
# They are regenerable binary evidence, not source. Kept on disk for human
# inspection; deliberately not tracked. (Task 2's record asks for exactly this:
# "仍属临时产物，收尾时移出仓库或进 .gitignore".)
browser-verify-*.png
5e-SRD-*.json
